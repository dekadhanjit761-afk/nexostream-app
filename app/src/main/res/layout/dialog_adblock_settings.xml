<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="#16161a"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ad Shields &amp; Settings"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#1010b981"
        android:padding="10dp"
        android:text="● Safe Redirect Killer: 100% Active. All hijack and popups permanently eliminated."
        android:textColor="#34d399"
        android:textSize="11sp" />

    <Switch
        android:id="@+id/sw_ublock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="uBlock Origin Rules"
        android:textColor="#ffffff" />

    <Switch
        android:id="@+id/sw_easylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="EasyList Standard"
        android:textColor="#ffffff" />

    <Switch
        android:id="@+id/sw_privacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="EasyPrivacy Protection"
        android:textColor="#ffffff" />

    <Button
        android:id="@+id/btn_close_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:backgroundTint="#26262b"
        android:text="Apply &amp; Close"
        android:textColor="#ffffff" />

</LinearLayout>
